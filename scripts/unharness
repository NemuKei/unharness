#!/bin/sh
set -eu
unharness_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ ! -x "$unharness_root/runtime/bin/node" ]; then
  printf '%s\n' 'Unharness: bundled runtime is missing. Use the complete Mac distribution.' >&2
  exit 1
fi
exec "$unharness_root/runtime/bin/node" "$unharness_root/bin/unharness.mjs" "$@"
