{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "unharness",
  "version": "0.0.2",
  "description": "Save, prepare and compare your local Codex loadouts.",
  "author": {
    "name": "DeltaHelm Lab",
    "url": "https://deltahelmlab.com/"
  },
  "homepage": "https://unharness.deltahelmlab.com",
  "repository": "https://github.com/NemuKei/unharness",
  "license": "MIT",
  "keywords": [
    "codex",
    "local",
    "harness",
    "comparison"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Unharness",
        "shortDescription": "Your local Codex loadouts, ready to compare.",
        "longDescription": "Save Normal, prepare UNSEAL or TRUEFORM for a fresh task, compare selected work and restore safely. Configuration and saved data stay on your Mac.",
        "developerName": "DeltaHelm Lab",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://unharness.deltahelmlab.com",
        "defaultPrompt": [
          "アンハーネスを開いて",
          "Unharnessの設定を相談したい"
        ],
        "brandColor": "#59D8C5"
      }
    }
  }
}
